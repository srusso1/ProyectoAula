<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox fx:id="formularioIngreso" alignment="CENTER" prefHeight="500.0" prefWidth="420.0" spacing="25.0" styleClass="formContainer" stylesheets="@../../css/loginStyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.login.LoginFormController">
   <padding>
      <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
   </padding>
   <children>
      <Label alignment="CENTER" prefHeight="30.0" prefWidth="256.0" styleClass="titleLogin" text="Iniciar sesión" textAlignment="CENTER">
         <font>
            <Font name="Roboto Regular" size="39.0" />
         </font>
      </Label>
      <TextField fx:id="txtUsuario" maxWidth="800.0" prefHeight="60.0" prefWidth="329.0" promptText="Usuario registrado">
         <font>
            <Font size="15.0" />
         </font>
      </TextField>
      <PasswordField fx:id="txtPassword" maxWidth="800.0" prefHeight="60.0" prefWidth="329.0" promptText="Contraseña registrada">
         <font>
            <Font size="15.0" />
         </font>
      </PasswordField>
      <Button fx:id="btnIngresar" mnemonicParsing="false" onAction="#clickIngresar" prefHeight="41.0" prefWidth="130.0" styleClass="btnIngresar" text="Ingresar" />
      <TextFlow>
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Docente">
               <font>
                  <Font size="15.0" />
               </font>
            </Text>
            <Hyperlink onAction="#clickNoRegistrado" style="-fx-border-style: none; -fx-region-border: none;" text="click aquí">
               <font>
                  <Font size="15.0" />
               </font>
            </Hyperlink>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="para completar el registro">
               <font>
                  <Font size="15.0" />
               </font>
            </Text>
         </children>
      </TextFlow>
   </children>
</VBox>
