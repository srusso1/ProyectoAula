<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="620.0" prefWidth="900.0" stylesheets="@../../css/docente/ConsultarGradoStyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.docente.ConsultarGradoController">
   <children>
      <StackPane layoutX="167.0" layoutY="109.0" prefHeight="150.0" prefWidth="200.0" styleClass="bgInicio" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="40.0">
         <children>
            <VBox fx:id="contenedor" prefHeight="200.0" prefWidth="100.0" spacing="20.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="49.0" prefWidth="740.0" spacing="20.0">
                     <children>
                        <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../images/grupobusqueda.png" />
                           </image>
                        </ImageView>
                        <Label text="Consultar información de un grado">
                           <font>
                              <Font size="26.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <VBox prefHeight="86.0" prefWidth="690.0" spacing="15.0">
                     <children>
                        <Label lineSpacing="15.0" text="Elige el grado del que deseas consultar la información">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="comboBox" onAction="#elegirGrado" prefHeight="41.0" prefWidth="115.0" promptText="Grado" />
                     </children>
                  </VBox>
                  <TableView fx:id="tabla" prefHeight="293.0" prefWidth="690.0" styleClass="tabla" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colNombre" prefWidth="141.0" text="NOMBRE" />
                      <TableColumn fx:id="colGrado" prefWidth="73.0" text="GRADO" />
                        <TableColumn fx:id="colRegistros" prefWidth="139.0" text="INGRESOS" />
                        <TableColumn fx:id="colIngresosTarde" prefWidth="147.0" text="INGRESOS TARDE" />
                        <TableColumn fx:id="colInfo" prefWidth="190.0" text="INFORMACIÓN" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
               <padding>
                  <Insets left="50.0" top="50.0" />
               </padding>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
