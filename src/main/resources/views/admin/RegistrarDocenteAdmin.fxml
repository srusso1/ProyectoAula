<AnchorPane prefHeight="620.0" prefWidth="900.0" stylesheets="@../../css/admin/RegistrarDocenteAdminStyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.RegistrarDocenteAdminController">
   <children>
      <StackPane layoutX="45.0" layoutY="113.0" prefHeight="550.0" prefWidth="800.0" styleClass="container" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="40.0">
